GEMINI_API_KEY=your_gemini_api_key_here

# Optional: swap adapters (defaults shown)
VECTOR_ADAPTER=sqlite
LLM_ADAPTER=gemini

# LLM_ADAPTER=ollama 時生效（本機推理，不需 GEMINI_API_KEY）
# 事前準備：ollama pull qwen3:14b && ollama pull bge-m3
# ⚠️ 切換 embedding provider（gemini 3072 維 ↔ bge-m3 1024 維）後舊向量不相容：
#    請先備份 data/rag.db，再重新 ingest 所有文件
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_GEN_MODEL=qwen3:14b
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_NUM_CTX=16384   # 勿用 Ollama 預設 4096：system prompt+工具宣告會被靜默截斷、模型亂答

PORT=3000
